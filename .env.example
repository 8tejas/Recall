# Recall Platform Configuration

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL / Supabase / SQLite fallback)
# Supabase / Local PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/recall_db
DATABASE_URL=sqlite:///./recall.db

# Groq AI Provider
# Primary model: openai/gpt-oss-120b or llama-3.3-70b-versatile
# Lightweight model: openai/gpt-oss-20b or llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
